{
  "id": "hr-workforce",
  "name": "HR — Workforce & Attrition",
  "description": "Employee records with tenure, compensation, performance, and attrition flags. Designed for attrition modeling and bias-testing exercises.",
  "domain": "hr",
  "tags": ["hr", "workforce", "attrition", "fairness"],
  "algorithm": {
    "name": "CTGAN",
    "epochs": 250,
    "batch_size": 400,
    "embedding_dim": 64
  },
  "target_rows_default": 1000,
  "target_rows_max_anonymous": 1000,
  "target_rows_max_free": 10000,
  "version": "1.0.0",
  "columns": [
    { "name": "employee_pseudo_id", "type": "uuid", "pii_class": "none" },
    { "name": "dept", "type": "categorical", "pii_class": "none", "constraints": { "values": ["engineering", "sales", "marketing", "support", "ops", "finance", "hr", "legal"] } },
    { "name": "level", "type": "categorical", "pii_class": "none", "constraints": { "values": ["L1", "L2", "L3", "L4", "L5", "L6", "L7"] } },
    { "name": "tenure_months", "type": "integer", "pii_class": "none", "constraints": { "min": 0, "max": 480 } },
    { "name": "base_comp_usd", "type": "float", "pii_class": "sensitive" },
    { "name": "bonus_pct", "type": "float", "pii_class": "sensitive", "constraints": { "min": 0, "max": 1 } },
    { "name": "perf_rating", "type": "categorical", "pii_class": "sensitive", "constraints": { "values": ["below", "meets", "exceeds", "outstanding"] } },
    { "name": "remote", "type": "boolean", "pii_class": "none" },
    { "name": "manager_span", "type": "integer", "pii_class": "none", "constraints": { "min": 0, "max": 50 } },
    { "name": "promoted_last_24m", "type": "boolean", "pii_class": "none" },
    { "name": "attrited", "type": "boolean", "pii_class": "none", "description": "Left the company within observation window. Base rate ~13%." }
  ]
}
